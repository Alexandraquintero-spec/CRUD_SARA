# ─────────────────────────────────────────────────────────────
# Variables de entorno de la API SARA.
# Copie este archivo como ".env" y reemplace los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Conexión a PostgreSQL con el rol de mínimos privilegios (database/03_dcl.sql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bd_sara
DB_SCHEMA=sara
DB_USER=sara_api
DB_PASSWORD=cambie_esta_clave

# JWT: use una cadena larga y aleatoria (por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=cambie_esta_clave_por_una_cadena_larga_y_aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Clave para cifrar las plantillas faciales (Fernet). La de este ejemplo es la
# clave DE DEMOSTRACIÓN con la que se cifraron los datos de prueba de 02_dml.sql.
# En producción genere otra (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# y vuelva a registrar los rostros.
CLAVE_BIOMETRIA=U0FSQS1kZW1vLWJpb21ldHJpYS1jbGF2ZS0yMDI2ISE=

# Orígenes autorizados para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seguridad de inicio de sesión
MAX_INTENTOS_LOGIN=5
MINUTOS_BLOQUEO=15

# Reglas del servicio de gastronomía
ZONA_HORARIA=America/Bogota
HORA_INICIO_RESERVA=07:00
HORA_FIN_RESERVA=09:00
HORA_INICIO_ALMUERZO=12:00
HORA_FIN_ALMUERZO=13:30
AFORO_MAXIMO=110
UMBRAL_SIMILITUD=90
# Ponga false solo para pruebas fuera del horario real (sustentación o Postman)
VALIDAR_HORARIOS=true
